# Official French school holidays ICS URL (Zone C by default)
CALENDAR_ICS_URL=https://fr.ftp.opendatasoft.com/openscol/fr-en-calendrier-scolaire/Zone-C.ics

# Virtual switch metadata shown in Google Home
DEVICE_ID=zone-c-school-holidays
DEVICE_NAME=Vacances Scolaires Zone C

# Constant single-user identifier shared across SYNC, OAuth, and HomeGraph Report State
AGENT_USER_ID=zone-c-user-1

# OAuth 2.0 credentials configured in Google Home Developer Console (Account Linking)
GOOGLE_CLIENT_ID=replace-with-random-client-id
GOOGLE_CLIENT_SECRET=replace-with-random-client-secret

# Optional: Google Home Developer Console Project ID (locks redirect_uri to /r/<PROJECT_ID>)
GOOGLE_PROJECT_ID=

# Secret used to sign OAuth authorization codes, access tokens, and refresh tokens (min 32 chars)
OAUTH_SIGNING_SECRET=replace-with-at-least-32-chars-random-secret

# Password entered on the Google Home Account Linking login screen & dashboard admin actions
ADMIN_PASSWORD=replace-with-strong-password

# Vercel Cron secret (automatically sent as Authorization: Bearer <CRON_SECRET> by Vercel)
CRON_SECRET=replace-with-random-cron-secret

# Google Cloud Service Account JSON (for HomeGraph Report State & Request Sync)
# Paste the single-line JSON content of the downloaded service account key file:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternatively, you can provide email + private key separately instead of GOOGLE_SERVICE_ACCOUNT_JSON:
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
